# Install as /etc/aib/role.env, owned by root:root with mode 0644.
# Replace these example ids with the dedicated role account and groups for this instance.
# AIB_ROLE_GROUPS must not contain aib-shared; use separate provider-exec,
# credential, and project/workspace groups. AIB_ROLE_GID must not be aib-shared.
# Confined roles must not receive aib-tasks either; task-intent reads board.json.
# The agent unit pins AIB_CONFINE_BIN=/opt/aib/engine/libexec/landlock-exec.
AIB_ROLE_UID=20001
AIB_ROLE_GID=20001
AIB_ROLE_UIDS=20001
AIB_ROLE_GROUPS=20002,20003
AIB_SUP_STATE_ROOT=/var/lib/aib-sup
