polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var loginStart = action.id === "org.freedesktop.systemd1.manage-units" &&
        verb === "start" && /^aib-login@[a-z0-9-]+\.service$/.test(unit);

    if (subject.isInGroup("aib-gateway") && loginStart) {
        return polkit.Result.YES;
    }
});
