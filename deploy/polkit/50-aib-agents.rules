polkit.addRule(function(action, subject) {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var unitAction = action.id === "org.freedesktop.systemd1.manage-units" &&
        (verb === "start" || verb === "stop");
    var unitFileAction = action.id === "org.freedesktop.systemd1.manage-unit-files" &&
        (verb === "enable" || verb === "disable");

    var agentUnit = /^aib-agent@[a-z0-9-]+\.service$/.test(unit) &&
        (unitAction || unitFileAction);
    var loginUnit = /^aib-login(-refresh)?@[a-z0-9-]+\.service$/.test(unit) &&
        unitAction;

    if (subject.isInGroup("aib-ops") && (agentUnit || loginUnit)) {
        return polkit.Result.YES;
    }
});
