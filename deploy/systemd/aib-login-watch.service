[Unit]
Description=BobNet shared-login expiry watch
# %n preserves the complete failed unit name; %N would remove its type suffix.
OnFailure=aib-alarm@%n.service

[Service]
Type=oneshot
User=aib-broker
ExecStart=/opt/aib/engine/bin/aib-login-watch
ReadOnlyPaths=/var/lib/aib/login
ReadWritePaths=/run/aib/login-status /var/lib/aib/login-state /srv/aib/outbox/_server
