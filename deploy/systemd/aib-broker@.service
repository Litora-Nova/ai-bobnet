[Unit]
Description=BobNet broker connection %i
Documentation=file:/opt/aib/engine/docs/CONTRACT-mediation.md

[Service]
ExecStart=/opt/aib/engine/bin/aib-broker-handler
User=aib-broker
Group=aib-broker

# RM-3 slice 3: unit-environment-only, per docs/CONFINEMENT.md and ADR-0005 —
# never request- or registry-supplied. AIB_EVENT_ROOT names the broker's own
# durable event stream location, outside every project home; AIB_CONFINE_BIN
# is the absolute, install-time-compiled confinement helper the handler execs
# the provider through and nothing else. Neither has a bash-level fallback if
# omitted here: an unset AIB_EVENT_ROOT fails every launch closed
# (reason=event_store_unavailable) rather than silently guessing a path.
Environment=AIB_EVENT_ROOT=/var/lib/aib/events
Environment=AIB_CONFINE_BIN=/opt/aib/engine/libexec/landlock-exec
Environment=AIBOBNET_REGISTRY=/opt/aib/registry.json

# RM-3 slice 5 (ADR-0006): capacity ceiling shared by every agent within one project,
# checked by flock leases before the registry is ever read for a connection. Default if
# omitted is 12; MUST stay below deploy/systemd/aib-broker.socket's MaxConnections (16
# below) — a ceiling at or above that point can never be reached, because the socket
# itself would already have silently closed the connection first. The handler refuses to
# start (a journal line, not a launch failure) if AIB_BROKER_CAPACITY >=
# AIB_BROKER_MAX_CONNECTIONS.
Environment=AIB_BROKER_CAPACITY=12
# Mirrors aib-broker.socket's MaxConnections so this unit can self-check the rule above
# without reading the socket unit at runtime. Keep this in sync BY HAND with
# deploy/systemd/aib-broker.socket's MaxConnections= line; nothing enforces agreement
# between the two files automatically.
Environment=AIB_BROKER_MAX_CONNECTIONS=16

# EXPLICIT, and this is the trap: with Accept=yes systemd does NOT hand the connection to the
# handler by itself. Measured on 2026-08-10 - without these two lines the handler received
# nothing on stdin and wrote its answer to the journal. Six connections, six empty replies,
# client rc=0 each time: a silently non-functional service.
StandardInput=socket
StandardOutput=socket
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Site drop-ins: ReadWritePaths MUST include every registry project home and standup_dir.
# ProtectSystem=strict makes other persistent paths read-only, including the
# workspace and heartbeat directory unless a site grants them explicitly.
# See aib-broker@.service.d/site.conf.example; keep the broker paths below.
ReadWritePaths=/var/lib/aib /run/aib
