[Unit]
Description=BobNet broker connection %i
Documentation=file:/opt/aib/engine/docs/CONTRACT-mediation.md

[Service]
ExecStart=/opt/aib/engine/bin/aib-broker-handler
User=aib-broker
Group=aib-broker

# RM-3 slice 3: unit-environment-only, per docs/CONFINEMENT.md and ADR-0005 —
# never request- or registry-supplied. AIB_EVENT_ROOT names the broker's own
# durable event stream location, outside every project home; AIB_CONFINE_BIN
# is the absolute, install-time-compiled confinement helper the handler execs
# the provider through and nothing else. Neither has a bash-level fallback if
# omitted here: an unset AIB_EVENT_ROOT fails every launch closed
# (reason=event_store_unavailable) rather than silently guessing a path.
Environment=AIB_EVENT_ROOT=/var/lib/aib/events
Environment=AIB_CONFINE_BIN=/opt/aib/engine/libexec/landlock-exec
Environment=AIBOBNET_REGISTRY=/opt/aib/registry.json

# Sprint I-B slice 1 (docs/PROVIDERS.md, ADR-0009): this unit's own User= line above already
# fixes HOME=/var/lib/aib (from the aib-broker passwd entry), so the codex adapter's
# CODEX_HOME resolves to /var/lib/aib/.codex with no Environment= line here to set it — no
# behaviour change to this unit. Provisioning must create that directory (aib-broker:aib-broker
# 0700, empty) and its config.toml (root:aib-broker 0644) before the codex provider is
# registered; run_confined adds $HOME/.codex to LL_RW itself (docs/CONFINEMENT.md,
# "Effective-sandbox -> LL_RW"), unit-derived, never request-derived.

# RM-3 slice 5 (ADR-0006): ONE capacity ceiling for the WHOLE BROKER — every project,
# every agent, one shared pool, checked by flock leases in AIB_EVENT_ROOT/attempts/
# before agent_uid is resolved and before the registry is ever read for a connection.
# Deliberately NOT scoped per project or per agent: project_uid comes from agent_uid,
# which the caller chooses and the broker does not verify at this point (§4) — a
# per-project or per-agent pool would let a caller target one project's or one agent's
# budget specifically, the same denial-of-service shape ADR-0006 rejects for the cap
# this replaces. Default if omitted is 12; MUST stay below deploy/systemd/
# aib-broker.socket's MaxConnections (16 below) — a ceiling at or above that point can
# never be reached, because the socket itself would already have silently closed the
# connection first. The handler refuses to start (a journal line, not a launch failure)
# if AIB_BROKER_CAPACITY >= AIB_BROKER_MAX_CONNECTIONS.
Environment=AIB_BROKER_CAPACITY=12
# Mirrors aib-broker.socket's MaxConnections so this unit can self-check the rule above
# without reading the socket unit at runtime. DRIFT RISK, accepted (ADR-0006, maintainer
# review 2026-09-07): nothing enforces agreement between this value and the socket's own
# MaxConnections= line — they are two separate files, hand-edited independently, and a
# change to one that is not mirrored to the other silently weakens or defeats this
# self-check. Keep them in sync BY HAND; there is no automated guard against drift.
Environment=AIB_BROKER_MAX_CONNECTIONS=16

# EXPLICIT, and this is the trap: with Accept=yes systemd does NOT hand the connection to the
# handler by itself. Measured on 2026-08-10 - without these two lines the handler received
# nothing on stdin and wrote its answer to the journal. Six connections, six empty replies,
# client rc=0 each time: a silently non-functional service.
StandardInput=socket
StandardOutput=socket
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Site drop-ins: ReadWritePaths MUST include every registry project home and standup_dir.
# ProtectSystem=strict makes other persistent paths read-only, including the
# workspace and heartbeat directory unless a site grants them explicitly.
# See aib-broker@.service.d/site.conf.example; keep the broker paths below.
ReadWritePaths=/var/lib/aib /run/aib
