#!/usr/bin/env python3
"""Provision one project's task stream and body-sidecar directories."""

from __future__ import annotations

import grp
import os
import re
import stat
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.environ.get("AIB_TEST_SEAMS") != "1" or (ROOT / ".aib-installed").exists():
    os.environ.pop("AIB_TASK_ROOT", None)
    os.environ.pop("AIB_TASK_GROUP", None)

TOKEN = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z", re.ASCII)


DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


def expected_owner() -> int:
    test_seam = os.environ.get("AIB_TEST_SEAMS") == "1" and not (ROOT / ".aib-installed").exists()
    return os.geteuid() if test_seam else 0


def existing_owner_ok(fd: int) -> bool:
    return os.fstat(fd).st_uid == expected_owner()


def set_dir(fd: int, mode: int, gid: int) -> bool:
    try:
        if not stat.S_ISDIR(os.fstat(fd).st_mode):
            return False
        if os.geteuid() == 0:
            os.fchown(fd, 0, gid)
        else:
            os.fchown(fd, -1, gid)
        # chown may clear setgid; mode is the final provisioning assertion.
        os.fchmod(fd, mode)
        return True
    except OSError:
        return False


def root_dir(path: Path, mode: int, gid: int) -> int:
    if not path.is_absolute():
        return -1
    current_fd = os.open("/", DIR_FLAGS)
    try:
        parts = path.parts[1:]
        if not parts:
            return -1
        final_created = False
        for index, name in enumerate(parts):
            try:
                next_fd = os.open(name, DIR_FLAGS, dir_fd=current_fd)
            except FileNotFoundError:
                os.mkdir(name, mode if index == len(parts) - 1 else 0o755, dir_fd=current_fd)
                next_fd = os.open(name, DIR_FLAGS, dir_fd=current_fd)
                if index == len(parts) - 1:
                    final_created = True
            os.close(current_fd)
            current_fd = next_fd
        if not final_created and not existing_owner_ok(current_fd):
            return -1
        if not set_dir(current_fd, mode, gid):
            return -1
        result, current_fd = current_fd, -1
        return result
    except OSError:
        return -1
    finally:
        if current_fd >= 0:
            os.close(current_fd)


def real_dir(parent_fd: int, name: str, mode: int, gid: int) -> int:
    child_fd = -1
    created = False
    try:
        try:
            os.mkdir(name, mode, dir_fd=parent_fd)
            created = True
        except FileExistsError:
            pass
        child_fd = os.open(name, DIR_FLAGS, dir_fd=parent_fd)
        if not created and not existing_owner_ok(child_fd):
            return -1
        if not set_dir(child_fd, mode, gid):
            return -1
        result, child_fd = child_fd, -1
        return result
    except OSError:
        return -1
    finally:
        if child_fd >= 0:
            os.close(child_fd)


def real_file(directory_fd: int, name: str, gid: int) -> bool:
    file_fd = -1
    created = False
    try:
        flags = os.O_RDWR | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC
        try:
            file_fd = os.open(name, flags | os.O_CREAT | os.O_EXCL, 0o640, dir_fd=directory_fd)
            created = True
        except FileExistsError:
            file_fd = os.open(name, flags, dir_fd=directory_fd)
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            return False
        if not created and info.st_uid != expected_owner():
            return False
        if os.geteuid() == 0:
            os.fchown(file_fd, 0, gid)
        else:
            os.fchown(file_fd, -1, gid)
        os.fchmod(file_fd, 0o640)
        return True
    except OSError:
        return False
    finally:
        if file_fd >= 0:
            os.close(file_fd)


def main(argv: list[str]) -> int:
    if len(argv) != 1 or TOKEN.fullmatch(argv[0]) is None:
        return 64
    try:
        gid = grp.getgrnam(os.environ.get("AIB_TASK_GROUP", "aib-tasks")).gr_gid
    except KeyError:
        return 78
    root_value = os.environ.get("AIB_TASK_ROOT", "/var/lib/aib/tasks")
    if not root_value:
        return 78
    root = Path(root_value)
    if not root.is_absolute():
        return 78
    root_fd = project_fd = bodies_fd = -1
    try:
        root_fd = root_dir(root, 0o755, gid)
        if root_fd < 0:
            return 78
        project_fd = real_dir(root_fd, argv[0], 0o2750, gid)
        if project_fd < 0:
            return 78
        bodies_fd = real_dir(project_fd, "bodies", 0o2750, gid)
        if bodies_fd < 0:
            return 78
        if not real_file(project_fd, "tasks.events", gid) or not real_file(project_fd, "tasks.events.lock", gid):
            return 78
        return 0
    finally:
        for fd in (bodies_fd, project_fd, root_fd):
            if fd >= 0:
                os.close(fd)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
