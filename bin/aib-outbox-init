#!/usr/bin/env python3
"""Create safe team and server outbox directories from the registry."""

from __future__ import annotations

import json
import os
import re
import stat
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.environ.get("AIB_TEST_SEAMS") != "1" or (ROOT / ".aib-installed").exists():
    os.environ.pop("AIBOBNET_REGISTRY", None)
    os.environ.pop("AIB_OUTBOX_ROOT", None)
sys.path.insert(0, str(ROOT / "lib"))
from aib_control import registry_path  # noqa: E402

NAME_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z", re.ASCII)


def ensure_dir(path: Path, mode: int) -> bool:
    try:
        if path.is_symlink():
            return False
        path.mkdir(parents=False, exist_ok=True)
        if path.is_symlink() or not path.is_dir():
            return False
        current = path.stat(follow_symlinks=False)
        os.chmod(path, mode | (stat.S_IMODE(current.st_mode) & stat.S_ISGID))
        return True
    except OSError:
        return False


def ensure_file(path: Path) -> bool:
    directory_fd = file_fd = -1
    try:
        directory_fd = os.open(
            path.parent,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
        directory = os.fstat(directory_fd)
        file_fd = os.open(
            path.name,
            os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o660,
            dir_fd=directory_fd,
        )
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            return False
        os.fchmod(file_fd, 0o660)
        os.fchown(file_fd, 0 if os.geteuid() == 0 else os.geteuid(), directory.st_gid)
        return True
    except OSError:
        return False
    finally:
        for fd in (file_fd, directory_fd):
            if fd >= 0:
                os.close(fd)


def main() -> int:
    registry_file = registry_path(ROOT)
    outbox_root = Path(os.environ.get("AIB_OUTBOX_ROOT", "/srv/aib/outbox"))
    try:
        registry = json.loads(registry_file.read_text(encoding="utf-8"))
        agents = registry["agents"]
        if not isinstance(agents, dict):
            raise ValueError
    except (OSError, UnicodeError, json.JSONDecodeError, KeyError, ValueError, TypeError):
        return 66
    try:
        outbox_root.mkdir(parents=True, exist_ok=True)
    except OSError:
        return 78
    result = 0
    if not ensure_dir(outbox_root / "_server", 0o750):
        result = 78
    elif not ensure_file(outbox_root / "_server" / "outbox.md"):
        result = 78
    teams: set[str] = set()
    for agent in agents.values():
        if not isinstance(agent, dict) or agent.get("mode") != "supervised":
            continue
        team = agent.get("team_uid")
        if not isinstance(team, str) or NAME_RE.fullmatch(team) is None:
            if result < 65:
                result = 65
            continue
        teams.add(team)
    for team in sorted(teams):
        if not ensure_dir(outbox_root / team, 0o770):
            result = 78
        elif not ensure_file(outbox_root / team / "outbox.md"):
            result = 78
    return result


if __name__ == "__main__":
    raise SystemExit(main())
