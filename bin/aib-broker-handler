#!/usr/bin/env bash
# ai-bobnet — RM-3 broker, one connection instance (mediated launch contract §6).
#
# systemd spawns one of these per accepted connection; the connection is stdin AND stdout,
# which the unit has to say EXPLICITLY (see deploy/systemd/aib-broker@.service).
#
# Slice 2 scope: `authorize` moves behind this seam. The handler resolves the snapshot
# from the BROKER'S OWN registry (§2: "the snapshot comes from the broker's own
# registry, never from the caller"), contains `cwd` against the registry-derived root
# (SPEC-wire-format), and asks the PDP for a verdict. Every path still answers with a
# terminal status line before exiting — a refusal the caller cannot read is
# indistinguishable from a dead broker.
#
# What still does NOT move in slice 2:
#   - Enactment. No provider process starts here; every allow answers `enacted=no` so
#     a verdict is never mistaken for a launch (§2.1 confinement is slice 3).
#   - The wrapper's extra refusal of --sandbox danger-full-access. The PDP's own
#     clamp-to-capability is the contracted behaviour (§3) and stays a clamp, not a
#     refusal (SPEC-wire-format, "Assurances that must move with authorize").
set -uo pipefail

AIB_ROOT=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)
# shellcheck source=lib/aibobnet.sh
. "$AIB_ROOT/lib/aibobnet.sh"

if ! aib_wire_read_request; then
  # The reason is our own text, never caller-controlled content echoed back.
  aib_wire_write_response error "reason=malformed_request" "detail=${AIB_WIRE_ERROR:-unspecified}"
  exit 2
fi

case "${AIB_REQ_OP:-}" in
  launch) : ;;
  *) aib_wire_write_response denied "reason=unknown_operation"; exit 2 ;;
esac

# --- resolve the snapshot from the BROKER'S OWN registry (§2), never the caller's ---
# aib_resolve_managed_agent aib_die's on any registry/config problem. It is called
# here inside a command substitution so its exit status becomes ours to classify
# instead of ending this process outright — the same "run captured, then classify"
# idiom this file already used for the wire reader in slice 1. A denial is a
# decision; a broker that cannot decide is an incident, and the two answers must
# never look alike to the caller.
_aib_broker_resolve_snapshot() {
  aib_resolve_managed_agent "$1" || return $?
  printf 'home=%s\n%s' "$AIB_HOME" \
    "$(aib_build_pdp_snapshot_record "$AIB_CLEARANCE" "$AIB_PROVIDER" "$AIB_EFFORT" \
        "$AIB_ADAPTER_PATH" "$AIB_CAP_SANDBOX" "$AIB_CAP_TIER" "$AIB_CAP_EFFORT" "$AIB_CAP_TIMEOUT")"
}

# stdout and stderr are merged deliberately: on success the ONLY output is the printf
# above (resolution itself never writes to stdout), and on failure it is aib_die's own
# "ai-bobnet: <message>" line — which we need to read, to tell "unknown agent_uid" (a
# denial) apart from every other registry/config failure (an incident). None of this
# reaches the actual connection stdout: the whole call is inside `$( )`.
_resolve_out="$( _aib_broker_resolve_snapshot "${AIB_REQ_AGENT_UID:-}" 2>&1 )"
_resolve_rc=$?

if [ "$_resolve_rc" -ne 0 ]; then
  case "$_resolve_rc" in
    2)
      # _aib_load_registry_snapshot / _aib_check_registry_snapshot: the registry file
      # is missing, unreadable, or fails structural validation. The broker cannot
      # decide anything — that is an incident, not a verdict on this request.
      aib_wire_write_response error "reason=registry_unavailable"
      exit 2
      ;;
    3)
      case "$_resolve_out" in
        *"unknown agent_uid"*)
          # The one exit-3 message that means exactly "this agent_uid is not in the
          # registry" (_aib_split_agent_with). Every other exit-3 message here is a
          # registry CONFIGURATION problem (unknown project/team, an execution
          # binding absent everywhere, an undeclared provider) — a fact about the
          # registry, not about whether this particular agent_uid exists.
          aib_wire_write_response denied "reason=unknown_agent"
          exit 3
          ;;
        *)
          aib_wire_write_response error "reason=registry_config"
          exit 2
          ;;
      esac
      ;;
    *)
      # Any other resolver failure (registry internally inconsistent, a malformed
      # agent_uid the wire should already have rejected, …) is likewise a
      # configuration problem the broker cannot resolve on its own, and must not be
      # read by the caller as a decision about their specific request.
      aib_wire_write_response error "reason=registry_config"
      exit 2
      ;;
  esac
fi

_home="${_resolve_out%%$'\n'*}"
_home="${_home#home=}"
_snapshot="${_resolve_out#*$'\n'}"

# --- cwd containment: the registry-derived root, never the caller's choice ----------
# The Landlock positive list (slice 3) is derived from the registry, never the
# request (SPEC-wire-format). cwd only selects where inside that fixed area the child
# starts; outside it, the request is a rejection, not a security problem needing a
# character-class rule.
if ! aib_contain_cwd "$_home" "${AIB_REQ_CWD:-}"; then
  aib_wire_write_response denied "reason=cwd_outside_root"
  exit 3
fi

# Build the request record exactly like the PEP does (bin/launch-agent), via the
# shared helper: same field order and shape, one definition. cwd goes in RESOLVED —
# containment already ran, and the PDP itself does not decide cwd (§3: "partly").
#
# An absent sandbox defaults to "read-only", mirroring bin/launch-agent's own
# `sandbox="read-only"` default (SPEC-wire-format does not fix this; the PDP has no
# "absent means use the cap" fallback for sandbox the way it does for timeout, and an
# unrecognised value is a form deny — an absent one must not silently become that).
_request="$(aib_build_pdp_request_record "${AIB_REQ_AGENT_UID:-}" "${AIB_REQ_SANDBOX:-read-only}" \
  "$AIB_CWD_RESOLVED" "${AIB_REQ_TIMEOUT:-}" "${AIB_REQ_LABEL:-}")"

if aib_authorize_launch "$_request" "$_snapshot"; then
  # enacted=no on every allow: no provider process has started here. A verdict is not
  # a launch — enactment under §2.1 confinement is slice 3. cwd is echoed only in its
  # RESOLVED form; label and prompt (caller free text) are never echoed back at all.
  aib_wire_write_response ok \
    "decision=$AIB_VERDICT_DECISION" \
    "code=$AIB_VERDICT_CODE" \
    "effective_sandbox=$AIB_VERDICT_EFFECTIVE_SANDBOX" \
    "effective_clearance=$AIB_VERDICT_EFFECTIVE_CLEARANCE" \
    "effective_effort=$AIB_VERDICT_EFFECTIVE_EFFORT" \
    "effective_timeout=$AIB_VERDICT_EFFECTIVE_TIMEOUT" \
    "cwd=$AIB_CWD_RESOLVED" \
    "reasons=$AIB_VERDICT_REASONS" \
    "enacted=no"
  exit 0
else
  aib_wire_write_response denied \
    "decision=$AIB_VERDICT_DECISION" \
    "code=$AIB_VERDICT_CODE" \
    "reasons=$AIB_VERDICT_REASONS"
  exit 3
fi
