#!/usr/bin/env bash
# ai-bobnet — RM-3 broker, one connection instance (mediated launch contract §6).
#
# systemd spawns one of these per accepted connection; the connection is stdin AND stdout,
# which the unit has to say EXPLICITLY (see deploy/systemd/aib-broker@.service).
#
# Slice 2 moved `authorize` behind this seam: the handler resolves the snapshot from
# the BROKER'S OWN registry (§2: "the snapshot comes from the broker's own registry,
# never from the caller"), contains `cwd` against the registry-derived root
# (SPEC-wire-format), and asks the PDP for a verdict.
#
# Slice 3 (this revision) adds §2 steps 2-4 for real: `commit(attempt.decided)` on
# EVERY verdict (deny too — CONTRACT-codex-run.md §4 item 1: "the deny path writes
# exactly one attempt.decided record and fails closed"), enactment under §2.1
# confinement on allow (`aib_enact_launch`, lib/aibobnet.sh — the same function
# bin/launch-agent's in-process path uses, in "confined" mode here), and
# `commit(attempt.ended)`. The durable stream lives at `$AIB_EVENT_ROOT/<project_uid>`
# (ADR-0005), never under the project's `standup_dir` — the confined child's `LL_RW`
# may safely include `home` (and therefore `standup_dir`) only because the stream
# and the high-water anchor live OUTSIDE it. `AIB_EVENT_ROOT` is unit-environment-only,
# exactly like `AIB_CONFINE_BIN` (docs/CONFINEMENT.md) — never request- or
# registry-supplied — and this handler fails closed if it is unset or unwritable:
# an attempt this handler cannot durably record is an incident, not a launch.
#
# What still does NOT move here:
#   - The wrapper's extra refusal of --sandbox danger-full-access. The PDP's own
#     clamp-to-capability is the contracted behaviour (§3) and stays a clamp, not a
#     refusal (SPEC-wire-format, "Assurances that must move with authorize").
#   - Wire-level errors (malformed request, registry unavailable, unknown agent,
#     cwd not found/outside root): SPEC-wire-format.md is explicit that these keep
#     the slice-1/2 shape unchanged — no prologue, no decided_event_id, because no
#     verdict was ever reached. Only a REAL PDP verdict (allow or deny) commits.
#
# D2 (gate delta, Ikarus — CLOSED this slice, not just stated): aib_contain_cwd closes
# the window where a symlink is planted at a cwd BEFORE this handler authorises it
# (resolution requires existence, realpath -e, which fully resolves symlinks). It does
# NOT close the window where a symlink is swapped in AFTER authorisation and BEFORE the
# provider actually starts — this handler and the PDP both run well before enactment.
# `aib_enact_launch` re-checks `pwd -P` against the registry-derived root immediately
# before exec, inside the same enactment that installs Landlock (SPEC-wire-format.md,
# "cwd — the field that stops carrying authority").
set -uo pipefail

# D1 (gate delta, Ikarus, HIGH): must be in effect BEFORE the prologue write, not just
# inside aib_enact_launch's own confined-mode path (which is called strictly after the
# prologue and did not exist yet). A client that disconnects right after sending its
# request can be gone before this process ever writes a byte back — with SIGPIPE at its
# default disposition, the write that discovers that kills this process outright,
# leaving a persisted attempt.decided with no attempt.ended. Ignoring SIGPIPE turns that
# same write into an ordinary EPIPE return this file already checks for (see the
# prologue write below); never restored, because this is a short-lived per-connection
# process that only ever wants EPIPE-as-return-code for its whole life.
trap '' PIPE

AIB_ROOT=$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)
# shellcheck source=lib/aibobnet.sh
. "$AIB_ROOT/lib/aibobnet.sh"

# Unit-only admission settings are checked before reading even a frame.
_broker_misconfigured() {
  printf 'ai-bobnet: AIB_BROKER_CAPACITY / AIB_BROKER_MAX_CONNECTIONS: %s\n' "$1" >&2
  aib_wire_write_response error "reason=broker_misconfigured"
  exit 2
}
_broker_positive_limit() {
  # A bounded canonical decimal avoids bash arithmetic overflow and octal input.
  [[ "$1" =~ ^[1-9][0-9]{0,8}$ ]]
}
_capacity="${AIB_BROKER_CAPACITY-12}"
_broker_positive_limit "$_capacity" || _broker_misconfigured 'expected positive decimal (1..999999999)'
if [ "${AIB_BROKER_MAX_CONNECTIONS+x}" ]; then
  _broker_positive_limit "$AIB_BROKER_MAX_CONNECTIONS" || _broker_misconfigured 'invalid socket ceiling mirror'
  [ "$_capacity" -lt "$AIB_BROKER_MAX_CONNECTIONS" ] || _broker_misconfigured 'capacity must be below socket ceiling mirror'
fi
AIB_ENACT_ANCHOR_MODE=anchor

if ! aib_wire_read_request; then
  # The reason is our own text, never caller-controlled content echoed back.
  aib_wire_write_response error "reason=malformed_request" "detail=${AIB_WIRE_ERROR:-unspecified}"
  exit 2
fi

case "${AIB_REQ_OP:-}" in
  launch) : ;;
  # Gate delta (should-fix LOW, Riker): exit 3 for every `denied`, exit 2 for every
  # `error` — the discipline this diff formalises everywhere else in this file. This
  # was the one denied answer still exiting 2, a leftover from slice 1.
  *) aib_wire_write_response denied "reason=unknown_operation"; exit 3 ;;
esac

# One broker-global pool, before any registry/PDP/stream access. Keep the
# admission lock only for count/create; the lease remains open for this connection.
_broker_store_error() {
  printf 'ai-bobnet: admission store unavailable: %s\n' "$1" >&2
  aib_wire_write_response error "reason=event_store_unavailable"
  exit 2
}
[ -n "${AIB_EVENT_ROOT:-}" ] || _broker_store_error 'AIB_EVENT_ROOT is unset'
command -v flock >/dev/null 2>&1 || _broker_store_error 'flock is missing'
_attempts="$AIB_EVENT_ROOT/attempts"
( umask 0077; mkdir -p -- "$_attempts" ) || _broker_store_error 'cannot create attempts directory'
exec {_admission_fd}>>"$_attempts/attempts.lock" || _broker_store_error 'cannot open attempts lock'
flock -x -w 10 "$_admission_fd" || _broker_store_error 'attempts lock timeout'
_live=0
for _lease in "$_attempts"/*; do
  # This directory can also be the stream directory for a project named
  # attempts. Only validated agent-label + decimal-index names are leases.
  [[ "${_lease##*/}" =~ ^[a-z0-9]+(-[a-z0-9]+)+\.[0-9]+$ ]] || continue
  [ -e "$_lease" ] || continue
  exec {_probe_fd}>>"$_lease" || _broker_store_error 'cannot open lease'
  flock -n -x "$_probe_fd"; _lease_rc=$?
  case "$_lease_rc" in
    0) rm -f -- "$_lease" || _broker_store_error 'cannot remove stale lease';;
    1) _live=$((_live+1));;
    *) _broker_store_error 'cannot probe lease lock';;
  esac
  exec {_probe_fd}>&-
done
if [ "$_live" -ge "$_capacity" ]; then
  exec {_admission_fd}>&-
  aib_wire_write_response error "reason=over_capacity"
  exit 2
fi
_slot=0
while [ -e "$_attempts/${AIB_REQ_AGENT_UID}.$_slot" ]; do _slot=$((_slot+1)); done
[ "$_slot" -lt "$_capacity" ] || _broker_store_error 'no free lease index'
exec {AIB_BROKER_LEASE_FD}>>"$_attempts/${AIB_REQ_AGENT_UID}.$_slot" || _broker_store_error 'cannot create lease'
flock -n -x "$AIB_BROKER_LEASE_FD" || _broker_store_error 'cannot acquire new lease'
exec {_admission_fd}>&-

# --- resolve the snapshot from the BROKER'S OWN registry (§2), never the caller's ---
# aib_resolve_managed_agent aib_die's on any registry/config problem. It is called
# here inside a command substitution so its exit status becomes ours to classify
# instead of ending this process outright — the same "run captured, then classify"
# idiom this file already used for the wire reader in slice 1. A denial is a
# decision; a broker that cannot decide is an incident, and the two answers must
# never look alike to the caller.
_aib_broker_resolve_snapshot() {
  aib_resolve_managed_agent "$1" || return $?
  printf 'home=%s\n%s' "$AIB_HOME" \
    "$(aib_build_pdp_snapshot_record "$AIB_CLEARANCE" "$AIB_PROVIDER" "$AIB_EFFORT" \
        "$AIB_ADAPTER_PATH" "$AIB_CAP_SANDBOX" "$AIB_CAP_TIER" "$AIB_CAP_EFFORT" "$AIB_CAP_TIMEOUT")"
}

# stdout and stderr are merged deliberately: on success the ONLY output is the printf
# above (resolution itself never writes to stdout), and on failure it is aib_die's own
# "ai-bobnet: <message>" line — which we need to read, to tell "unknown agent_uid" (a
# denial) apart from every other registry/config failure (an incident). None of this
# reaches the actual connection stdout: the whole call is inside `$( )`.
_resolve_out="$( _aib_broker_resolve_snapshot "${AIB_REQ_AGENT_UID:-}" 2>&1 )"
_resolve_rc=$?

if [ "$_resolve_rc" -ne 0 ]; then
  case "$_resolve_rc" in
    2)
      # _aib_load_registry_snapshot / _aib_check_registry_snapshot: the registry file
      # is missing, unreadable, or fails structural validation. The broker cannot
      # decide anything — that is an incident, not a verdict on this request.
      aib_wire_write_response error "reason=registry_unavailable"
      exit 2
      ;;
    3)
      case "$_resolve_out" in
        *"unknown agent_uid"*)
          # The one exit-3 message that means exactly "this agent_uid is not in the
          # registry" (_aib_split_agent_with). Every other exit-3 message here is a
          # registry CONFIGURATION problem (unknown project/team, an execution
          # binding absent everywhere, an undeclared provider) — a fact about the
          # registry, not about whether this particular agent_uid exists.
          aib_wire_write_response denied "reason=unknown_agent"
          exit 3
          ;;
        *)
          aib_wire_write_response error "reason=registry_config"
          exit 2
          ;;
      esac
      ;;
    *)
      # Any other resolver failure (registry internally inconsistent, a malformed
      # agent_uid the wire should already have rejected, …) is likewise a
      # configuration problem the broker cannot resolve on its own, and must not be
      # read by the caller as a decision about their specific request.
      aib_wire_write_response error "reason=registry_config"
      exit 2
      ;;
  esac
fi

_home="${_resolve_out%%$'\n'*}"
_home="${_home#home=}"
_snapshot="${_resolve_out#*$'\n'}"

# --- cwd containment: the registry-derived root, never the caller's choice ----------
# The Landlock positive list (slice 3) is derived from the registry, never the
# request (SPEC-wire-format). cwd only selects where inside that fixed area the child
# starts; outside it, the request is a rejection, not a security problem needing a
# character-class rule.
#
# RM-3 slice 2 delta (gate finding, Ikarus D2): aib_contain_cwd now requires cwd to
# EXIST (realpath -e) and distinguishes why it refused, via AIB_CONTAIN_CWD_REASON.
# A cwd that simply does not exist is a distinct, nameable outcome from one that
# exists but sits outside the root — collapsing them into one reason would hide which
# problem the caller actually has.
if ! aib_contain_cwd "$_home" "${AIB_REQ_CWD:-}"; then
  case "${AIB_CONTAIN_CWD_REASON:-}" in
    not_found) aib_wire_write_response denied "reason=cwd_not_found" ;;
    *)         aib_wire_write_response denied "reason=cwd_outside_root" ;;
  esac
  exit 3
fi

# Build the request record exactly like the PEP does (bin/launch-agent), via the
# shared helper: same field order and shape, one definition. cwd goes in RESOLVED —
# containment already ran, and the PDP itself does not decide cwd (§3: "partly").
#
# An absent sandbox defaults to "read-only", mirroring bin/launch-agent's own
# `sandbox="read-only"` default (SPEC-wire-format does not fix this; the PDP has no
# "absent means use the cap" fallback for sandbox the way it does for timeout, and an
# unrecognised value is a form deny — an absent one must not silently become that).
_request="$(aib_build_pdp_request_record "${AIB_REQ_AGENT_UID:-}" "${AIB_REQ_SANDBOX:-read-only}" \
  "$AIB_CWD_RESOLVED" "${AIB_REQ_TIMEOUT:-}" "${AIB_REQ_LABEL:-}")"

_verdict_allow=1
aib_authorize_launch "$_request" "$_snapshot" || _verdict_allow=0

# --- re-resolve OUTSIDE a subshell -------------------------------------------
# _aib_broker_resolve_snapshot above ran inside `$( )` (so its exit status could
# be classified rather than ending this process) — every global
# aib_resolve_managed_agent sets (AIB_HOME, AIB_STANDUP_DIR, AIB_PROJECT_UID,
# AIB_TEAM_UID, AIB_PROVIDER/_SOURCE, AIB_MODEL/_SOURCE, AIB_EFFORT/_SOURCE,
# AIB_ADAPTER_PATH/_SOURCE, AIB_REGISTRY_SCHEMA_VERSION, …) therefore died with
# that subshell; only what it explicitly printed (home, the snapshot record)
# survived. We already know this call succeeds (identically — same registry
# file, same agent_uid, same deterministic resolver) because the first one
# already did; this second, ordinary call is what makes those globals exist in
# THIS process for the commit envelope, the enact-record, and the child's
# AIBOBNET_* exports below.
aib_resolve_managed_agent "${AIB_REQ_AGENT_UID:-}"

# --- §2 step 2: commit(attempt.decided) on EVERY verdict, allow or deny ------
# ADR-0005: the broker's OWN stream, outside every project home. AIB_EVENT_ROOT
# is unit-environment-only (never request/registry-supplied), exactly like
# AIB_CONFINE_BIN — an attempt this handler cannot durably record is an
# incident, not a launch, so this fails closed before ever touching the PDP's
# answer.
: "${AIB_EVENT_ROOT:=}"
if [ -z "$AIB_EVENT_ROOT" ]; then
  aib_wire_write_response error "reason=event_store_unavailable"
  exit 2
fi
_event_dir="$AIB_EVENT_ROOT/$AIB_PROJECT_UID"
if ! mkdir -p -- "$_event_dir" 2>/dev/null || [ ! -w "$_event_dir" ]; then
  aib_wire_write_response error "reason=event_store_unavailable"
  exit 2
fi
AIB_EVENT_FILE="$_event_dir/main.events"
AIB_EVENT_LOCK="$_event_dir/main.events.lock"

# D-E: actor_type=service (the existing enum — no new value), actor_id names
# the broker's own identity, a constant (§3.1: the broker fills actor_id
# itself, not a request field).
_broker_envelope="$(printf 'project_uid=%s\nactor_type=service\nactor_id=aib-broker\nagent_uid=%s\nteam_uid=%s\nsession_id=%s' \
  "$AIB_PROJECT_UID" "${AIB_REQ_AGENT_UID:-}" "$AIB_TEAM_UID" "$AIB_MUX_SESSION")"

LC_ALL=C
_prompt_len=${#AIB_REQ_PROMPT}
_label_len=${#AIB_REQ_LABEL}
_audit_label="${AIB_REQ_LABEL//$'\n'/ }"
_audit_label="${_audit_label//$'\r'/ }"
_sha256_bin="$(command -v sha256sum)" || aib_die 6 "required runtime dependency not found: sha256sum (coreutils)"
_prompt_sha_output="$(printf '%s' "$AIB_REQ_PROMPT" | "$_sha256_bin")" || aib_die 2 "cannot compute prompt sha256"
_prompt_sha256="${_prompt_sha_output%% *}"

_decided_kv="$(printf 'decision=%s\ncode=%s\nreasons=%s\nprovider_resolved=%s\nprovider_source=%s\nmodel_resolved=%s\nmodel_source=%s\neffort_resolved=%s\neffort_source=%s\nsandbox_requested=%s\nadapter_raw=%s\nadapter_source=%s\npid=%s\nprompt_len=%s\nprompt_sha256=%s\nlabel=%s\nlabel_len=%s' \
  "$AIB_VERDICT_DECISION" "$AIB_VERDICT_CODE" "$AIB_VERDICT_REASONS" \
  "$AIB_PROVIDER" "$AIB_PROVIDER_SOURCE" "$AIB_MODEL" "$AIB_MODEL_SOURCE" \
  "$AIB_EFFORT" "$AIB_EFFORT_SOURCE" "${AIB_REQ_SANDBOX:-read-only}" "$AIB_ADAPTER_PATH" \
  "$AIB_ADAPTER_SOURCE" "$$" "$_prompt_len" "$_prompt_sha256" "$_audit_label" "$_label_len")"
if [ "$_verdict_allow" -eq 1 ]; then
  _decided_kv="${_decided_kv}"$'\n'"$(printf 'provider_effective=%s\nmodel_effective=%s\neffort_effective=%s\nsandbox_effective=%s\nadapter_effective=%s' \
    "$AIB_PROVIDER" "$AIB_MODEL" "$AIB_VERDICT_EFFECTIVE_EFFORT" \
    "$AIB_VERDICT_EFFECTIVE_SANDBOX" "$AIB_VERDICT_ADAPTER_PATH")"
fi
# D7 fix (gate delta, Ikarus, MEDIUM): this file is declared `set -uo pipefail` —
# deliberately no `-e` — and MUST stay that way for its whole life: `aib_enact_launch`
# below returns non-zero for every non-"ok" provider outcome by design (its own
# return mirrors AIB_ENACT_EXIT_CLASS), and this handler needs to run its blocked
# heartbeat and still exit 0 for that case ("end=ok" means the broker did its job,
# not that the provider succeeded). A `set +e ... set -e` bracket here used to leave
# `-e` ENABLED for the rest of this process (it was never on before), so a later
# provider failure silently killed the handler via errexit before the heartbeat/exit-0
# path ever ran, instead of the process failing case ended below. Capture the
# commit's rc without ever touching `-e`.
_decided_payload="$(aib_event_compose_decided_payload "$_decided_kv")"
# Capture the commit: aib_die exits its process on incidents. The handler must
# still send the wire terminal, including an anchor refusal before enactment.
_decided_result="$(
  aib_event_commit "$AIB_EVENT_FILE" "$AIB_EVENT_LOCK" attempt.decided "$_broker_envelope" "$_decided_payload" "" anchor &&
    printf 'OK:%s' "$AIB_EVENT_COMMIT_EVENT_ID"
)"; _decided_commit_rc=$?
if [ "$_decided_commit_rc" -ne 0 ]; then
  aib_wire_write_response error "reason=event_store_unavailable"
  exit 2
fi
_decided_event_id="${_decided_result#OK:}"

if [ "$_verdict_allow" -ne 1 ]; then
  # codex-run.md §4 item 1 / SPEC-wire-format "Deny": decided-only, no
  # enactment, no chunk section — closes the RM-1 hole where a deny left no
  # trace at all.
  aib_wire_write_response denied \
    "decision=$AIB_VERDICT_DECISION" \
    "code=$AIB_VERDICT_CODE" \
    "reasons=$AIB_VERDICT_REASONS" \
    "decided_event_id=$_decided_event_id"
  exit 3
fi

# --- §2 steps 3-4: enactment (§2.1 confinement) + commit(attempt.ended) -----
# Prologue FIRST (SPEC-wire-format.md, "Response frame"): everything in it is
# already known from the verdict, decided_event_id included — commit(decided)
# already happened, above. This is NOT aib_wire_write_response (that appends
# `end=` unconditionally, which would put a terminal line in front of the
# chunks) — a client reading to the first `end=` must not stop here.
#
# D1 (gate delta, Ikarus, HIGH): built as ONE string and written in ONE
# `printf`, so there is exactly one write to check — a client gone before any
# of it is read makes this fail (EPIPE, `trap '' PIPE` above turns the kill
# into a plain nonzero return) instead of dying mid-prologue with a decided
# record and no ended. On that failure, no enactment ever started (no child,
# no manager, nothing to reap) — the same abort outcome
# aib_enact_launch/aib-broker-handler already commit elsewhere for a
# self-initiated abort with no more specific information, so it is committed
# the same way here, directly (aib_enact_launch was never reached).
_prologue="$(printf 'decision=%s\ncode=%s\neffective_sandbox=%s\neffective_clearance=%s\neffective_effort=%s\neffective_timeout=%s\ncwd=%s\nreasons=%s\ndecided_event_id=%s\nenacted=yes' \
  "$AIB_VERDICT_DECISION" "$AIB_VERDICT_CODE" "$AIB_VERDICT_EFFECTIVE_SANDBOX" \
  "$AIB_VERDICT_EFFECTIVE_CLEARANCE" "$AIB_VERDICT_EFFECTIVE_EFFORT" "$AIB_VERDICT_EFFECTIVE_TIMEOUT" \
  "$AIB_CWD_RESOLVED" "$AIB_VERDICT_REASONS" "$_decided_event_id")"
if ! printf '%s\n' "$_prologue"; then
  # R3 (gate delta 2, Ikarus MEDIUM): no provider was ever invoked here — the
  # client is gone before enactment starts at all. stage=provider would claim
  # a provider outcome that never happened; stage=transport says what actually
  # ended the attempt (docs/CONTRACT-execution-binding.md §8.1).
  aib_event_commit "$AIB_EVENT_FILE" "$AIB_EVENT_LOCK" attempt.ended "$_broker_envelope" \
    "$(aib_event_compose_ended_payload $'exit_class=aborted\nstage=transport\nsignal=TERM')" \
    "$_decided_event_id" anchor >/dev/null || true
  exit 0
fi

_broker_label="${AIB_REQ_LABEL:-codex-run}"
_broker_hb() {
  # D-G: a broker-owned umask must not lock the agent account out of its own
  # heartbeat file — files THIS process creates under the shared standup_dir
  # stay group-appendable.
  ( umask 0002; aib_log_resolved "$AIB_STANDUP_DIR" "${AIB_REQ_AGENT_UID:-}" "$1" "$2" )
}
_broker_hb busy "codex-run: $AIB_MODEL/$AIB_VERDICT_EFFECTIVE_SANDBOX effort=$AIB_VERDICT_EFFECTIVE_EFFORT — $_broker_label"

# D-F: env -i, HOME/PATH from THIS process's own context (the allow-list loop
# inside aib_enact_launch reads AIB_VERDICT_ENV_ALLOW, already set by the
# aib_authorize_launch call above), the PEP's AIBOBNET_* exports — same shape,
# built from the broker's own resolved snapshot rather than launch-agent's.
# AIBOBNET_ATTEMPT_ID is added by aib_enact_launch itself, always, last.
AIB_ENACT_CHILD_ENV_EXTRA=(
  "AIBOBNET_AGENT_UID=${AIB_REQ_AGENT_UID:-}"
  "AIBOBNET_PROJECT_UID=$AIB_PROJECT_UID"
  "AIBOBNET_AGENT_KEY=$AIB_AGENT_KEY"
  "AIBOBNET_PROFILE=$AIB_PROFILE"
  "AIBOBNET_CLEARANCE=$AIB_CLEARANCE"
  "AIBOBNET_TEAM_UID=$AIB_TEAM_UID"
  "AIBOBNET_HOME=$AIB_HOME"
  "AIBOBNET_STANDUP_DIR=$AIB_STANDUP_DIR"
  "AIBOBNET_INBOX_PATH=$AIB_INBOX_PATH"
  "AIBOBNET_MUX_SESSION=$AIB_MUX_SESSION"
  "AIBOBNET_PROVIDER=$AIB_PROVIDER"
  "AIBOBNET_PROVIDER_SOURCE=$AIB_PROVIDER_SOURCE"
  "AIBOBNET_MODEL=$AIB_MODEL"
  "AIBOBNET_MODEL_SOURCE=$AIB_MODEL_SOURCE"
  "AIBOBNET_EFFORT=$AIB_EFFORT"
  "AIBOBNET_EFFORT_SOURCE=$AIB_EFFORT_SOURCE"
  "AIBOBNET_REGISTRY_SCHEMA_VERSION=$AIB_REGISTRY_SCHEMA_VERSION"
  "STANDUP_DIR=$AIB_STANDUP_DIR"
)

# adapter argv identical to the PEP's (D-F): -m/-s/effort/prompt come from the
# VERDICT's effective values, never the request. root is AIB_HOME — the
# registry-derived Landlock boundary aib_enact_launch re-checks cwd against.
_enact_record="$(printf 'adapter=%s\nroot=%s\ncwd=%s\nsandbox=%s\neffort=%s\nmodel=%s\ntimeout=%s' \
  "$AIB_VERDICT_ADAPTER_PATH" "$AIB_HOME" "$AIB_CWD_RESOLVED" "$AIB_VERDICT_EFFECTIVE_SANDBOX" \
  "$AIB_VERDICT_EFFECTIVE_EFFORT" "$AIB_MODEL" "$AIB_VERDICT_EFFECTIVE_TIMEOUT")"

aib_enact_launch "$_enact_record" "${AIB_REQ_PROMPT:-}" "$AIB_EVENT_FILE" "$AIB_EVENT_LOCK" \
  "$_broker_envelope" "$_decided_event_id"

# D8 (gate delta, Ikarus, MEDIUM): a broker-side incident (the ended commit
# itself failed, after the provider already ran) is NOT the provider-outcome
# case below — aib_enact_launch already closed the wire with end=error
# itself; this process reports the incident the same way every other
# incident in this file does (exit 2), never the provider-outcome exit 0.
if [ -n "${AIB_ENACT_INCIDENT:-}" ]; then
  _broker_hb blocked "codex-run event_store_unavailable (post-enactment) — $_broker_label"
  exit 2
fi

if [ "$AIB_ENACT_EXIT_CLASS" = ok ]; then
  _broker_hb done "codex-run OK — $_broker_label"
else
  _broker_hb blocked "codex-run ${AIB_ENACT_EXIT_CLASS:-unknown} (${AIB_ENACT_STAGE:-unknown}) — $_broker_label"
fi
# end=ok already on the wire (aib_enact_launch's own terminal-line write): "the
# broker did its job", regardless of the provider's own exit class
# (SPEC-wire-format.md, "Terminal lines").
exit 0
