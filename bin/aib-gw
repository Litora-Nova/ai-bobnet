#!/usr/bin/env python3
"""Fail-closed forced-command gateway for the safe control verb subset."""

from __future__ import annotations

import os
import json
import re
import shlex
import socket
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.environ.get("AIB_TEST_SEAMS") != "1" or (ROOT / ".aib-installed").exists():
    for name in ("AIB_AGENTCTL", "AIB_GW_PEERS", "AIB_CONTROL_LOG", "AIB_IDENTITY_CMD", "AIB_LOGIN_SOCK_DIR"):
        os.environ.pop(name, None)
sys.path.insert(0, str(ROOT / "lib"))
from aib_control import append_record, identity_for  # noqa: E402

ID_RE = re.compile(r"[a-z0-9_-]{1,32}\Z", re.ASCII)
UID_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)+\Z", re.ASCII)
PROVIDER_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z", re.ASCII)
VORGANG_RE = re.compile(r"[0-9a-f]{32}\Z", re.ASCII)
CODE_RE = re.compile(rb"[A-Za-z0-9#_-]{1,256}\Z", re.ASCII)
ALLOWED = {"status", "standup", "feierabend", "neustart", "say", "login", "login-code"}


def audit(reason: str, peer: str, verb: str = "", target: str = "") -> int:
    try:
        append_record(
            Path(os.environ.get("AIB_CONTROL_LOG", "/srv/aib/standup/_control.jsonl")),
            "ctl.rejected",
            req=None,
            verb=verb,
            target=target,
            caller=identity_for(os.geteuid()),
            actor=f"gateway-peer:{peer}",
            reason=reason,
        )
    except (OSError, ValueError):
        return 73
    return 64 if reason == "gateway_malformed" else 77


def relay_code(provider: str, vorgang: str) -> int:
    raw = sys.stdin.buffer.read(258)
    if raw.endswith(b"\n"):
        raw = raw[:-1]
    if CODE_RE.fullmatch(raw) is None:
        return 64
    message = {
        "provider": provider,
        "vorgang": vorgang,
        "code": raw.decode("ascii"),
        "received_at": time.time(),
    }
    path = Path(os.environ.get("AIB_LOGIN_SOCK_DIR", "/run/aib")) / f"login-{provider}.sock"
    try:
        with socket.socket(socket.AF_UNIX) as connection:
            connection.settimeout(10)
            connection.connect(str(path))
            connection.sendall((json.dumps(message, separators=(",", ":")) + "\n").encode())
            reply_raw = connection.makefile("rb").readline(4097)
        reply = json.loads(reply_raw)
        if not isinstance(reply, dict):
            raise ValueError
    except (OSError, ValueError, json.JSONDecodeError, socket.timeout):
        print("login-code unavailable", file=sys.stderr)
        return 69
    if reply.get("ok") is True:
        return 0
    reason = reply.get("reason")
    if not isinstance(reason, str) or not reason:
        print("login-code unavailable", file=sys.stderr)
        return 69
    print(f"rejected: {reason}", file=sys.stderr)
    return 77


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[0] != "--id" or ID_RE.fullmatch(argv[1]) is None:
        return 64
    peer = argv[1]
    command = os.environ.get("SSH_ORIGINAL_COMMAND")
    if command is None:
        return 64
    if len(command.encode()) > 4096 or any(ord(char) < 32 or ord(char) == 127 for char in command):
        return audit("gateway_malformed", peer)
    peers = Path(os.environ.get("AIB_GW_PEERS", "/etc/aib/gateway-peers"))
    try:
        allowed_peers = {line.strip() for line in peers.read_text(encoding="utf-8").splitlines() if line.strip()}
    except OSError:
        allowed_peers = set()
    if peer not in allowed_peers:
        return audit("gateway_peer_denied", peer)

    if not command:
        return audit("gateway_malformed", peer)
    first = command.split(" ", 1)[0] if command else ""
    if first not in ALLOWED:
        return audit("gateway_verb_denied", peer, first)
    if first == "login-code":
        match = re.fullmatch(r"login-code ([a-z0-9]+(?:-[a-z0-9]+)*) ([0-9a-f]{32})", command, re.ASCII)
        if match is None:
            return audit("gateway_malformed", peer, first)
        provider, vorgang = match.groups()
        result = relay_code(provider, vorgang)
        if result == 64:
            return audit("gateway_malformed", peer, first, provider)
        return result
    if first == "login":
        match = re.fullmatch(r"login start ([a-z0-9]+(?:-[a-z0-9]+)*)", command, re.ASCII)
        if match is None:
            if command == "login" or command.startswith("login start"):
                return audit("gateway_malformed", peer, first)
            return audit("gateway_verb_denied", peer, first)
        provider = match.group(1)
        args = ["login", "start", provider]
    elif first == "say":
        match = re.fullmatch(r"say ([a-z0-9]+(?:-[a-z0-9]+)+) (.+)", command, re.ASCII)
        if match is None:
            return audit("gateway_malformed", peer, first)
        target, text = match.groups()
        args = ["say", target, text]
    else:
        match = re.fullmatch(r"(status|standup|feierabend|neustart) ([a-z0-9]+(?:-[a-z0-9]+)+)", command, re.ASCII)
        if match is None:
            return audit("gateway_malformed", peer, first)
        verb, target = match.groups()
        args = [verb, target]
    if first not in ("login",) and UID_RE.fullmatch(args[1]) is None:
        return audit("gateway_malformed", peer, first, args[1])
    executable = shlex.split(os.environ.get("AIB_AGENTCTL", str(ROOT / "bin" / "agentctl")))
    environment = os.environ.copy()
    environment["AIBOBNET_ACTOR"] = f"gateway-peer:{peer}"
    try:
        return subprocess.run([*executable, *args], env=environment, check=False).returncode
    except OSError:
        return 69


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
