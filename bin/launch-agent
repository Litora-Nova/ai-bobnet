#!/usr/bin/env bash
# ai-bobnet — RM-1 managed provider launcher: the Policy Enforcement Point (PEP).
# Resolves one registry snapshot, hands a request + snapshot to the pure Policy
# Decision Point (aib_authorize_launch), then ENACTS the verdict — it re-decides no
# authority of its own. It exec's the ABSOLUTE registry adapter (never a `codex` found
# through PATH from the launch cwd) inside a child environment CONSTRUCTED from the
# verdict's allow-list via `env -i` (never a denylist scrub).
#
# This is a policy gate for cooperating agents, NOT containment: a hostile local
# process can still run a provider directly. Non-bypassability is RM-3's job.
#
# Usage: launch-agent --as <agent_uid> [runtime options]
#                     (--prompt <text> | --prompt-file <file> | -)
# Runtime options: --sandbox, --cwd, --timeout, --label.
# Model and effort are registry-managed; provider is never a CLI/env input.
set -euo pipefail

# --- locate engine root (symlink-safe) ---------------------------------------
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)
  _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac
done
_dir=$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)
REPO_ROOT=$(cd -P "$_dir/.." >/dev/null 2>&1 && pwd)
# shellcheck source=lib/aibobnet.sh
. "$REPO_ROOT/lib/aibobnet.sh"

_usage='usage: launch-agent --as <agent_uid> [--sandbox <s>] [--cwd <dir>] [--timeout <secs>] [--label <text>] (--prompt <text>|--prompt-file <file>|-)'

as=""
sandbox="read-only"
cwd="$PWD"
timeout_s="1200"
label=""
prompt=""
prompt_file=""
prompt_source=""
seen_as=0
seen_sandbox=0
seen_cwd=0
seen_timeout=0
seen_label=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --as)
      [ "$seen_as" -eq 0 ] || aib_die 64 "repeated --as ($_usage)"
      [ "$#" -ge 2 ] || aib_die 64 "--as needs an agent_uid ($_usage)"
      as="$2"; seen_as=1; shift 2
      ;;
    --sandbox)
      [ "$seen_sandbox" -eq 0 ] || aib_die 64 "repeated --sandbox ($_usage)"
      [ "$#" -ge 2 ] || aib_die 64 "--sandbox needs a value ($_usage)"
      sandbox="$2"; seen_sandbox=1; shift 2
      ;;
    --cwd)
      [ "$seen_cwd" -eq 0 ] || aib_die 64 "repeated --cwd ($_usage)"
      [ "$#" -ge 2 ] || aib_die 64 "--cwd needs a directory ($_usage)"
      cwd="$2"; seen_cwd=1; shift 2
      ;;
    --timeout)
      [ "$seen_timeout" -eq 0 ] || aib_die 64 "repeated --timeout ($_usage)"
      [ "$#" -ge 2 ] || aib_die 64 "--timeout needs seconds ($_usage)"
      timeout_s="$2"; seen_timeout=1; shift 2
      ;;
    --label)
      [ "$seen_label" -eq 0 ] || aib_die 64 "repeated --label ($_usage)"
      [ "$#" -ge 2 ] || aib_die 64 "--label needs text ($_usage)"
      label="$2"; seen_label=1; shift 2
      ;;
    --prompt)
      [ -z "$prompt_source" ] || aib_die 64 "give exactly one prompt source (--prompt / --prompt-file / -)"
      [ "$#" -ge 2 ] || aib_die 64 "--prompt needs text ($_usage)"
      prompt="$2"; prompt_source=argument; shift 2
      ;;
    --prompt-file)
      [ -z "$prompt_source" ] || aib_die 64 "give exactly one prompt source (--prompt / --prompt-file / -)"
      [ "$#" -ge 2 ] || aib_die 64 "--prompt-file needs a file ($_usage)"
      prompt_file="$2"; prompt_source=file; shift 2
      ;;
    -)
      [ -z "$prompt_source" ] || aib_die 64 "give exactly one prompt source (--prompt / --prompt-file / -)"
      prompt="$(cat)"; prompt_source=stdin; shift
      ;;
    --model)
      aib_die 64 "--model is registry-managed in schema 3; remove the launcher override"
      ;;
    --effort)
      aib_die 64 "--effort is registry-managed in schema 3; remove the launcher override"
      ;;
    -h|--help)
      printf '%s\n' "$_usage"
      exit 0
      ;;
    *)
      aib_die 64 "unknown arg: $1 ($_usage)"
      ;;
  esac
done

# --- validate runtime input before any provider can start --------------------
[ "$seen_as" -eq 1 ] && [ -n "$as" ] || aib_die 64 "missing --as ($_usage)"
aib_validate_agent_uid "$as"
# Input hygiene at THIS entry point (fail-closed): danger-full-access is refused here
# before the PDP ever sees it. The PDP has a danger->clamp branch instead, which allows
# the request with the sandbox clamped to the capability.
#
# This refusal is therefore policy that lives in the wrapper, NOT behind the boundary.
# It was previously described here as "unreachable by design"; that described the
# absence of a second caller, not an enforced property, and the absence is ending:
# bin/aib-broker-handler already sources this library, and slice 2 moves authorize
# behind the socket. Verified against the PDP on 2026-08-16 — a direct call with
# danger-full-access returns decision=allow with the sandbox clamped.
# See docs/SPEC-wire-format.md, "Assurances that must move with authorize".
case "$sandbox" in
  read-only|workspace-write) ;;
  danger-full-access) aib_die 64 "refusing --sandbox danger-full-access (fail-closed; use workspace-write)";;
  *) aib_die 64 "invalid --sandbox '$sandbox' (expected: read-only|workspace-write)";;
esac
case "$timeout_s" in
  ''|*[!0-9]*) aib_die 64 "invalid --timeout '$timeout_s' (positive integer seconds)";;
esac
[ "$timeout_s" -gt 0 ] 2>/dev/null || aib_die 64 "invalid --timeout '$timeout_s' (must be > 0)"
[ -d "$cwd" ] || aib_die 2 "--cwd is not a directory: $cwd"
[ -n "$prompt_source" ] || aib_die 64 "no prompt (use --prompt <text>, --prompt-file <file>, or - for stdin)"
if [ "$prompt_source" = file ]; then
  [ -f "$prompt_file" ] || aib_die 2 "--prompt-file not found: $prompt_file"
  [ -r "$prompt_file" ] || aib_die 2 "--prompt-file is not readable: $prompt_file"
  prompt="$(<"$prompt_file")" || aib_die 2 "cannot read --prompt-file: $prompt_file"
fi
[ -n "$prompt" ] || aib_die 64 "prompt must not be empty"
_sha256_bin="$(command -v sha256sum)" || aib_die 6 "required runtime dependency not found: sha256sum (coreutils)"
_env_bin="$(command -v env)" || aib_die 6 "required runtime dependency not found: env (coreutils)"
_sleep_bin="$(command -v sleep)" || aib_die 6 "required runtime dependency not found: sleep (coreutils)"
_mktemp_bin="$(command -v mktemp)" || aib_die 6 "required runtime dependency not found: mktemp (coreutils)"

# --- exactly one managed resolution; everything below consumes this bundle ---
aib_resolve_managed_agent "$as"

# --- Policy Decision Point: the single authority for this launch --------------
# Build the two serialisable records and hand them to the pure PDP; the PEP takes no
# authority decision of its own. The requested sandbox/effort go in as-is — the PDP
# returns min(request, provider ceiling). On deny the PDP has already chosen the exit
# code; fail closed BEFORE any heartbeat or provider process starts.
_pep_request="$(printf 'agent_uid=%s\nsandbox=%s\ncwd=%s\ntimeout=%s\nlabel=%s' \
  "$AIB_AGENT_UID" "$sandbox" "$cwd" "$timeout_s" "$label")"
# RM-3 slice 2 added cap_timeout as a fourth provider capability, resolved by
# aib_resolve_managed_agent exactly like the other three; passing it through here is
# not a new behaviour, only the wrapper catching up to a shared PDP that now checks
# it. --timeout is validated above by this wrapper already; the PDP re-checks the
# same shape independently (it must be safe to call in isolation) and takes
# min(timeout_s, cap_timeout), never max.
_pep_snapshot="$(printf 'clearance=%s\nprovider=%s\neffort=%s\nadapter=%s\ncap_sandbox=%s\ncap_tier=%s\ncap_effort=%s\ncap_timeout=%s' \
  "$AIB_CLEARANCE" "$AIB_PROVIDER" "$AIB_EFFORT" "$AIB_ADAPTER_PATH" \
  "$AIB_CAP_SANDBOX" "$AIB_CAP_TIER" "$AIB_CAP_EFFORT" "$AIB_CAP_TIMEOUT")"
aib_authorize_launch "$_pep_request" "$_pep_snapshot" || true

# --- durable write-ahead decision --------------------------------------------
# The frozen Lane-A composers are the JSON-validity authority. The broker allocates
# identity under the stream lock; the PEP never composes or guesses an attempt id.
LC_ALL=C
_prompt_len=${#prompt}
_label_len=${#label}
_audit_label="${label//$'\n'/ }"
_audit_label="${_audit_label//$'\r'/ }"
_prompt_sha_output="$(printf '%s' "$prompt" | "$_sha256_bin")" ||
  aib_die 2 "cannot compute prompt sha256"
_prompt_sha256="${_prompt_sha_output%% *}"

aib_event_stream_paths "$AIB_STANDUP_DIR"
_event_envelope="$(printf 'project_uid=%s\nactor_type=service\nactor_id=launch-agent\nagent_uid=%s\nteam_uid=%s\nsession_id=%s' \
  "$AIB_PROJECT_UID" "$AIB_AGENT_UID" "$AIB_TEAM_UID" "$AIB_MUX_SESSION")"
_decided_kv="$(printf 'decision=%s\ncode=%s\nreasons=%s\nprovider_resolved=%s\nprovider_source=%s\nmodel_resolved=%s\nmodel_source=%s\neffort_resolved=%s\neffort_source=%s\nsandbox_requested=%s\nadapter_raw=%s\nadapter_source=%s\npid=%s\nprompt_len=%s\nprompt_sha256=%s\nlabel=%s\nlabel_len=%s' \
  "$AIB_VERDICT_DECISION" "$AIB_VERDICT_CODE" "$AIB_VERDICT_REASONS" \
  "$AIB_PROVIDER" "$AIB_PROVIDER_SOURCE" "$AIB_MODEL" "$AIB_MODEL_SOURCE" \
  "$AIB_EFFORT" "$AIB_EFFORT_SOURCE" "$sandbox" "$AIB_ADAPTER_PATH" \
  "$AIB_ADAPTER_SOURCE" "$$" "$_prompt_len" "$_prompt_sha256" "$_audit_label" "$_label_len")"
if [ "$AIB_VERDICT_DECISION" = allow ]; then
  _decided_kv="${_decided_kv}"$'\n'"$(printf 'provider_effective=%s\nmodel_effective=%s\neffort_effective=%s\nsandbox_effective=%s\nadapter_effective=%s' \
    "$AIB_PROVIDER" "$AIB_MODEL" "$AIB_VERDICT_EFFECTIVE_EFFORT" \
    "$AIB_VERDICT_EFFECTIVE_SANDBOX" "$AIB_VERDICT_ADAPTER_PATH")"
fi
AIB_ENACT_ANCHOR_MODE=""
[ "${AIBOBNET_EVENT_ANCHOR:-}" != 1 ] || AIB_ENACT_ANCHOR_MODE=anchor
_decided_payload="$(aib_event_compose_decided_payload "$_decided_kv")"
set +e
aib_event_commit "$AIB_EVENT_FILE" "$AIB_EVENT_LOCK" attempt.decided \
  "$_event_envelope" "$_decided_payload" "" "$AIB_ENACT_ANCHOR_MODE"
_event_commit_rc=$?
set -e
[ "$_event_commit_rc" -eq 0 ] ||
  aib_die "$_event_commit_rc" "attempt.decided commit failed"
_decided_event_id="$AIB_EVENT_COMMIT_EVENT_ID"
_terminal_written=0

_pep_commit_ended() {
  # 4-arg shape (class, stage, code, signal) — matches _aib_enact_commit_ended's
  # shape in lib/aibobnet.sh now that stage is required on every ended record
  # (gate delta, Ikarus D5): the composer fails closed on a missing stage, so
  # this pre-enactment IO-hygiene helper (non-executable adapter, which never
  # reaches aib_enact_launch) must supply one too.
  local exit_class="$1" stage="$2" exit_code="${3-}" signal="${4-}" ended_kv ended_payload
  [ "$_terminal_written" -eq 0 ] ||
    aib_die 2 "attempt '$_decided_event_id' already entered a terminal path"
  ended_kv="exit_class=$exit_class"$'\n'"stage=$stage"
  [ -z "$exit_code" ] || ended_kv="${ended_kv}"$'\n'"exit_code=$exit_code"
  [ -z "$signal" ] || ended_kv="${ended_kv}"$'\n'"signal=$signal"
  ended_payload="$(aib_event_compose_ended_payload "$ended_kv")"
  set +e
  aib_event_commit "$AIB_EVENT_FILE" "$AIB_EVENT_LOCK" attempt.ended \
    "$_event_envelope" "$ended_payload" "$_decided_event_id" "$AIB_ENACT_ANCHOR_MODE"
  _event_commit_rc=$?
  set -e
  [ "$_event_commit_rc" -eq 0 ] ||
    aib_die "$_event_commit_rc" "attempt.ended commit failed"
  _terminal_written=1
}

if [ "$AIB_VERDICT_DECISION" = deny ]; then
  aib_die "$AIB_VERDICT_CODE" "managed launch denied: $AIB_VERDICT_REASONS"
fi

# Enact the verdict: run at the effective (clamped) authority, and take the ABSOLUTE
# adapter path from the registry map — cwd/PATH can no longer select the adapter.
adapter_path="$AIB_VERDICT_ADAPTER_PATH"
sandbox="$AIB_VERDICT_EFFECTIVE_SANDBOX"
eff_effort="$AIB_VERDICT_EFFECTIVE_EFFORT"
# Gate delta D4 (Ikarus, HIGH): the watchdog below sleeps $timeout_s, and the
# timeout/failure heartbeat and die messages print it — all of that must reflect the
# CAPPED authority, never the caller-requested value, or the audit trail (and the
# watchdog itself) would claim a cap the process does not actually enforce. This is
# the same clamp-not-max rule §3 states for every other effective value; timeout was
# simply never reassigned to its effective form the way sandbox/effort are above.
timeout_s="$AIB_VERDICT_EFFECTIVE_TIMEOUT"
# Gate delta R2 (Ikarus/Riker, MEDIUM): the capped value's observability lives in the
# managed_launch_binding JSON event below (effective_timeout field), not in a second,
# bare stderr line — docs/CONTRACT-codex-run.md §4 requires EXACTLY one JSON object
# on stderr before the busy heartbeat, and a bare "effective_timeout=<n>" line ahead
# of it (on every allow, including paths that go on to refuse enactment) broke that.

# Every registered adapter accepts the frozen ABI; provider validity is resolved
# before enactment. Filesystem executability is checked below.

# IO hygiene (not authority): the PDP is pure and never stats the disk, so the PEP
# confirms the resolved adapter is actually executable before heartbeat/provider
# enactment. The write-ahead decision already exists, so this refusal closes it.
if [ ! -x "$adapter_path" ]; then
  _pep_commit_ended io-refused exec 127
  aib_die 127 "resolved adapter is not executable: $adapter_path"
fi

# One observability event: the resolved binding + the ABSOLUTE adapter path taken
# from the verdict (never a PATH/cwd lookup). Not durable audit or enforcement. This
# is NOT the frozen attempt.decided composer (Lane A) — adding a field here is not a
# schema change to the durable audit trail, only to this transient stderr line.
#
# effective_timeout (gate delta R2) is the verdict's capped value, the same one the
# watchdog below is armed with — a JSON NUMBER (the PDP guarantees digits-only on
# allow), not a string, unlike every other field here.
launch_binding_event="$(
  printf '{"event":"managed_launch_binding","agent_uid":%s,"provider":%s,"provider_source":%s,"model":%s,"model_source":%s,"effort":%s,"effort_source":%s,"adapter_path":%s,"effective_timeout":%s}' \
    "$(aib_json "$AIB_AGENT_UID")" \
    "$(aib_json "$AIB_PROVIDER")" \
    "$(aib_json "$AIB_PROVIDER_SOURCE")" \
    "$(aib_json "$AIB_MODEL")" \
    "$(aib_json "$AIB_MODEL_SOURCE")" \
    "$(aib_json "$AIB_EFFORT")" \
    "$(aib_json "$AIB_EFFORT_SOURCE")" \
    "$(aib_json "$adapter_path")" \
    "$timeout_s"
)"

# RM-3 slice 3: the manager subshell, watchdog, reap and exit-class mapping that
# used to live here are now aib_enact_launch (lib/aibobnet.sh), shared with
# bin/aib-broker-handler's confined path. This call is "direct" mode: it execs
# the adapter directly, NEVER touches AIB_CONFINE_BIN (§7 single-trust-domain —
# this wrapper has no confinement to apply), and hands back the provider's raw
# merged stdout+stderr on ITS OWN stdout for capture below, plus the
# AIB_ENACT_* globals in THIS process (never through a `$( )` around the call
# itself — that would fork a subshell and lose every one of them, the same
# hazard the RED spec's own fixture ran into before its capture was corrected
# to a plain foreground call with a file redirect).
#
# The child environment: aib_enact_launch's own allow-list loop reads
# AIB_VERDICT_ENV_ALLOW (already set by aib_authorize_launch above — the SAME
# global, not a second decision); AIB_ENACT_CHILD_ENV_EXTRA is this wrapper's
# rich AIBOBNET_* export set, unchanged from before extraction.
# AIBOBNET_ATTEMPT_ID is added by aib_enact_launch itself, always, last.
AIB_ENACT_CHILD_ENV_EXTRA=(
  "AIBOBNET_AGENT_UID=$AIB_AGENT_UID"
  "AIBOBNET_PROJECT_UID=$AIB_PROJECT_UID"
  "AIBOBNET_AGENT_KEY=$AIB_AGENT_KEY"
  "AIBOBNET_PROFILE=$AIB_PROFILE"
  "AIBOBNET_CLEARANCE=$AIB_CLEARANCE"
  "AIBOBNET_TEAM_UID=$AIB_TEAM_UID"
  "AIBOBNET_HOME=$AIB_HOME"
  "AIBOBNET_STANDUP_DIR=$AIB_STANDUP_DIR"
  "AIBOBNET_INBOX_PATH=$AIB_INBOX_PATH"
  "AIBOBNET_MUX_SESSION=$AIB_MUX_SESSION"
  "AIBOBNET_PROVIDER=$AIB_PROVIDER"
  "AIBOBNET_PROVIDER_SOURCE=$AIB_PROVIDER_SOURCE"
  "AIBOBNET_MODEL=$AIB_MODEL"
  "AIBOBNET_MODEL_SOURCE=$AIB_MODEL_SOURCE"
  "AIBOBNET_EFFORT=$AIB_EFFORT"
  "AIBOBNET_EFFORT_SOURCE=$AIB_EFFORT_SOURCE"
  "AIBOBNET_REGISTRY_SCHEMA_VERSION=$AIB_REGISTRY_SCHEMA_VERSION"
  "STANDUP_DIR=$AIB_STANDUP_DIR"
)

hb() {
  aib_log_resolved "$AIB_STANDUP_DIR" "$AIB_AGENT_UID" "$1" "$2"
}

_enact_record="$(printf 'adapter=%s\nroot=%s\ncwd=%s\nsandbox=%s\neffort=%s\nmodel=%s\ntimeout=%s' \
  "$adapter_path" "$AIB_HOME" "$cwd" "$sandbox" "$eff_effort" "$AIB_MODEL" "$timeout_s")"

printf '%s\n' "$launch_binding_event" >&2

lbl="${label:-codex-run}"
hb busy "codex-run: $AIB_MODEL/$sandbox effort=$eff_effort — $lbl"

# NOT `out="$(aib_enact_launch ...)"`: that would run the call itself inside a
# command-substitution subshell, and every AIB_ENACT_* global it publishes
# would die with that subshell instead of reaching the rest of this script —
# a plain foreground call with a file redirect keeps the call in THIS
# process, then a separate (harmless) command substitution just reads the
# file back.
_enact_out_file="$("$_mktemp_bin" "${TMPDIR:-/tmp}/aibobnet-launch.XXXXXX")" ||
  aib_die 2 "cannot create provider output buffer"
# `|| true`: aib_enact_launch's OWN return status mirrors AIB_ENACT_EXIT_CLASS
# (0 only for a clean provider success), which under this script's `set -e`
# would kill the whole process on any failure/timeout/abort BEFORE the rc
# translation below ever runs — exactly the failure/timeout paths this
# wrapper exists to report through aib_die itself, with the right message.
aib_enact_launch "$_enact_record" "$prompt" "$AIB_EVENT_FILE" "$AIB_EVENT_LOCK" \
  "$_event_envelope" "$_decided_event_id" direct >"$_enact_out_file" || true
out="$(<"$_enact_out_file")"
rm -f -- "$_enact_out_file" 2>/dev/null || true

# aib_enact_launch publishes AIB_ENACT_EXIT_CODE (numeric) or AIB_ENACT_SIGNAL
# (name) — never both, matching the ended-payload composer's own convention
# (§B7: a signal-terminated attempt has no exit_code, and vice versa). This
# wrapper's own die-message/heartbeat text always wants the raw numeric rc the
# original inline manager produced, so an "aborted" outcome is translated back
# through the same signal table aib_enact_launch itself uses internally;
# "ok" (neither field set) is rc=0.
rc="$AIB_ENACT_EXIT_CODE"
if [ -z "$rc" ]; then
  case "$AIB_ENACT_SIGNAL" in
    HUP) rc=129 ;; INT) rc=130 ;; KILL) rc=137 ;; TERM) rc=143 ;;
    SIGNAL-*) rc=$((128 + ${AIB_ENACT_SIGNAL#SIGNAL-})) ;;
    '') rc=0 ;;
  esac
fi

if [ "$rc" -eq 124 ]; then
  hb blocked "codex-run TIMEOUT after ${timeout_s}s — $lbl"
  printf '%s\n' "$out" >&2
  aib_die 124 "codex-run: timed out after ${timeout_s}s (watchdog killed the call)"
elif [ "$rc" -ne 0 ]; then
  hb blocked "codex-run FAILED rc=$rc — $lbl"
  printf '%s\n' "$out" >&2
  aib_die "$rc" "codex-run: codex exec failed (rc=$rc)"
fi

hb done "codex-run OK — $lbl"
printf '%s\n' "$out"
