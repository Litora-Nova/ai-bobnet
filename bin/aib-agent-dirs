#!/usr/bin/env python3
"""Prepare one supervised agent's state and transcript ACLs."""

from __future__ import annotations

import os
import re
import stat
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.environ.get("AIB_TEST_SEAMS") != "1" or (ROOT / ".aib-installed").exists():
    for name in (
        "AIB_SUP_STATE_ROOT",
        "AIB_STANDUP_DIR",
        "AIB_OPS_GROUP",
        "AIB_BROKER_GROUP",
        "AIB_SETFACL",
    ):
        os.environ.pop(name, None)

UID_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)+\Z", re.ASCII)


def real_directory(path: Path, mode: int | None = None) -> bool:
    try:
        if path.is_symlink():
            return False
        path.mkdir(parents=False, exist_ok=True)
        if path.is_symlink() or not path.is_dir():
            return False
        if mode is not None:
            os.chmod(path, mode)
        return True
    except OSError:
        return False


def directory_at(parent_fd: int, name: str, uid: int, gid: int, mode: int) -> int:
    """Create/open one directory without following a child-planted link."""
    try:
        os.mkdir(name, mode, dir_fd=parent_fd)
    except FileExistsError:
        pass
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent_fd)
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode):
        os.close(fd)
        raise OSError("unsafe directory entry")
    os.fchown(fd, uid, gid)
    os.fchmod(fd, mode)
    return fd


def prepare_heartbeat(standup: Path, name: str) -> bool:
    """Create or repair a shared heartbeat without following a planted link."""
    directory_fd = -1
    file_fd = -1
    try:
        directory_fd = os.open(standup, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        directory = os.fstat(directory_fd)
        if not stat.S_ISDIR(directory.st_mode):
            return False
        created = False
        try:
            file_fd = os.open(name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=directory_fd)
        except FileNotFoundError:
            try:
                file_fd = os.open(
                    name,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                    0o664,
                    dir_fd=directory_fd,
                )
                created = True
            except FileExistsError:
                file_fd = os.open(name, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW, dir_fd=directory_fd)
        info = os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode):
            return False
        if info.st_nlink > 1:
            return False
        if created:
            os.fchown(file_fd, directory.st_uid, directory.st_gid)
            os.fchmod(file_fd, 0o664)
        else:
            safe_mode = stat.S_IMODE(info.st_mode) & 0o666
            if info.st_uid != directory.st_uid:
                os.fchown(file_fd, directory.st_uid, -1)
            os.fchmod(file_fd, safe_mode)
        return True
    except OSError:
        return False
    finally:
        if file_fd >= 0:
            os.close(file_fd)
        if directory_fd >= 0:
            os.close(directory_fd)


def main(argv: list[str]) -> int:
    if len(argv) != 1 or UID_RE.fullmatch(argv[0]) is None:
        return 64
    uid = argv[0]
    role_uid_raw = os.environ.get("AIB_ROLE_UID", "")
    role_gid_raw = os.environ.get("AIB_ROLE_GID", "")
    role_enabled = bool(role_uid_raw or role_gid_raw)
    if role_enabled:
        if not (role_uid_raw.isdecimal() and role_gid_raw.isdecimal()):
            return 64
        role_uid = int(role_uid_raw)
        role_gid = int(role_gid_raw)
        if role_uid < 1000 or role_gid == 0:
            return 64
    else:
        role_uid = role_gid = -1
    state_root = Path(os.environ.get("AIB_SUP_STATE_ROOT", "/var/lib/aib-sup"))
    standup = Path(os.environ.get("AIB_STANDUP_DIR", "/srv/aib/standup"))
    group = os.environ.get("AIB_OPS_GROUP", "aib-ops")
    broker_group = os.environ.get("AIB_BROKER_GROUP", "aib-broker")
    setfacl = os.environ.get("AIB_SETFACL", "setfacl")
    state = state_root / uid
    transcripts = standup / "transcripts"
    try:
        standup.mkdir(parents=True, exist_ok=True)
    except OSError:
        return 78
    if not real_directory(state_root, 0o755):
        return 78
    if os.geteuid() == 0:
        try:
            os.chown(state_root, 0, 0)
            os.chmod(state_root, 0o755)
        except OSError:
            return 78
    if not real_directory(state, 0o700) or not real_directory(transcripts):
        return 78
    if not prepare_heartbeat(standup, f"{uid}.log"):
        return 78
    if role_enabled:
        state_fd = aib_fd = intents_fd = quarantine_fd = -1
        try:
            os.chown(state, role_uid, role_gid)
            state_fd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
            aib_fd = directory_at(state_fd, ".aib", role_uid, role_gid, 0o700)
            intents_fd = directory_at(aib_fd, "intents", role_uid, role_gid, 0o700)
            quarantine_fd = directory_at(state_fd, ".aib-quarantine", os.geteuid(), os.getegid(), 0o700)
            for name in (".claude", ".codex"):
                provider_dir = state / name
                if not real_directory(provider_dir, 0o700):
                    return 78
                os.chown(provider_dir, role_uid, role_gid)
            auth = state / ".codex" / "auth.json"
            target = Path(os.environ.get("AIB_LOGIN_ROOT", "/var/lib/aib/login")) / "codex" / "auth.json"
            if auth.is_symlink():
                if os.readlink(auth) != str(target):
                    return 78
            elif auth.exists():
                return 78
            else:
                auth.symlink_to(target)
                os.lchown(auth, role_uid, role_gid)
        except OSError:
            return 78
        finally:
            for fd in (quarantine_fd, intents_fd, aib_fd, state_fd):
                if fd >= 0:
                    os.close(fd)
    calls = [
        ["-m", f"g:{group}:--x", str(state)],
        ["-m", f"g:{broker_group}:--x", str(state)],
        ["-d", "-m", f"g:{group}:r-x", str(state)],
        ["-d", "-m", f"g:{broker_group}:r--", str(state)],
        ["-m", f"g:{group}:--x", str(transcripts)],
        ["-d", "-m", f"g:{group}:r-x", str(transcripts)],
    ]
    live = state / "live.json"
    if live.exists() and not live.is_symlink():
        calls.append(["-m", f"g:{group}:r--", str(live)])
        calls.append(["-m", f"g:{broker_group}:r--", str(live)])
    try:
        for args in calls:
            if subprocess.run([setfacl, *args], check=False).returncode != 0:
                return 69
    except OSError:
        return 69
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
