#!/usr/bin/env python3
"""Refresh one shared provider credential using the provider CLI itself."""

from __future__ import annotations

import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from aib_login import PROVIDERS, access_expiry, credential_path, integer, now, read_object, setting  # noqa: E402


def cadence() -> int:
    return max(1, integer("AIB_LOGIN_ACCESS_LIFETIME_S", 3600) // 2 - 1)


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[0] == "--cadence" and argv[1] in PROVIDERS:
        print(cadence())
        return 0
    if len(argv) != 1 or argv[0] not in PROVIDERS:
        return 64
    provider = argv[0]
    path = credential_path(provider)
    try:
        info = path.lstat()
    except FileNotFoundError:
        return 66
    except OSError:
        return 78
    if not stat.S_ISREG(info.st_mode):
        return 78
    original = path.read_bytes()
    data = read_object(path)
    expiry = access_expiry(provider, data or {})
    if expiry is None:
        return 78
    threshold = integer("AIB_LOGIN_REFRESH_BELOW_S", cadence() + integer("AIB_LOGIN_MAX_TURN_S", 900)
                        + integer("AIB_LOGIN_MARGIN_S", 300) + integer("AIB_LOGIN_SLACK_S", 600))
    if expiry - now() > threshold:
        return 0

    private = Path(tempfile.mkdtemp(prefix=f"aib-login-{provider}."))
    os.chmod(private, 0o700)
    try:
        shutil.copytree(path.parent, private, dirs_exist_ok=True)
        local = private / path.name
        env = os.environ.copy()
        if provider == "claude-code":
            env["CLAUDE_CONFIG_DIR"] = str(private)
            command = [setting("AIB_CLAUDE_BIN", "claude"), "-p"]
        else:
            env["CODEX_HOME"] = str(private)
            command = [setting("AIB_CODEX_BIN", "codex"), "features", "list"]
        result = subprocess.run(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        if result.returncode != 0:
            return 1
        updated = local.read_bytes()
        if updated == original:
            return 1
        fd, raw = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        tmp = Path(raw)
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.write(updated)
            os.chmod(tmp, 0o640)
            os.replace(tmp, path)
        finally:
            try:
                tmp.unlink()
            except FileNotFoundError:
                pass
        return 0
    except (OSError, subprocess.SubprocessError):
        return 1
    finally:
        shutil.rmtree(private, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
