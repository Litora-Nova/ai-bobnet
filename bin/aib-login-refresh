#!/usr/bin/env python3
"""Refresh one shared provider credential using the provider CLI itself."""

from __future__ import annotations

import base64
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from aib_login import (  # noqa: E402
    CLAUDE_BIN,
    CODEX_BIN,
    PROVIDERS,
    access_expiry,
    credential_path,
    integer,
    login_margin_seconds,
    login_max_turn_seconds,
    login_slack_seconds,
    now,
    read_object,
    refresh_cadence_seconds,
    setting,
    store_lock,
    trusted_store_file,
)


def cadence() -> int:
    return refresh_cadence_seconds()


def store_meets_broker_floor(provider: str, path: Path) -> bool:
    expiry = access_expiry(provider, read_object(path) or {})
    floor = login_max_turn_seconds() + login_margin_seconds() + login_slack_seconds()
    if expiry is None or expiry - now() < floor:
        print(f"aib-login-refresh: {provider} credential remains below broker floor", file=sys.stderr)
        return False
    return True


def force_private_expiry(provider: str, path: Path) -> bytes:
    """Move only the private copy into the CLIs' measured <=300 s refresh window."""
    data = read_object(path)
    if data is None:
        raise ValueError("invalid credential")
    forced = now() + 60
    if provider == "claude-code":
        oauth = data.get("claudeAiOauth")
        if not isinstance(oauth, dict):
            raise ValueError("invalid Claude credential")
        oauth["expiresAt"] = forced * 1000
    else:
        tokens = data.get("tokens")
        token = tokens.get("access_token") if isinstance(tokens, dict) else None
        if not isinstance(token, str) or len(token.split(".")) != 3:
            raise ValueError("invalid Codex credential")
        header, payload, signature = token.split(".")
        decoded = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
        if not isinstance(decoded, dict):
            raise ValueError("invalid Codex JWT")
        decoded["exp"] = forced
        changed = base64.urlsafe_b64encode(
            json.dumps(decoded, separators=(",", ":")).encode()
        ).rstrip(b"=").decode()
        tokens["access_token"] = f"{header}.{changed}.{signature}"
    path.write_text(json.dumps(data, separators=(",", ":")), encoding="utf-8")
    return path.read_bytes()


def run_cli(command: list[str], environment: dict[str, str]) -> int:
    # Diagnostics name the binary and the outcome only; the CLI's own output may carry
    # account data and is never echoed.
    try:
        process = subprocess.Popen(
            command,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError as error:
        print(f"aib-login-refresh: cannot run {command[0]}: {error.strerror or type(error).__name__}", file=sys.stderr)
        return 1
    try:
        process.communicate(timeout=integer("AIB_LOGIN_CLI_TIMEOUT_S", 120))
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.communicate()
        print(f"aib-login-refresh: {command[0]} timed out", file=sys.stderr)
        return 1
    if process.returncode != 0:
        print(f"aib-login-refresh: {command[0]} exited with status {process.returncode}", file=sys.stderr)
    return process.returncode


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[0] == "--cadence" and argv[1] in PROVIDERS:
        print(cadence())
        return 0
    if len(argv) != 1 or argv[0] not in PROVIDERS:
        return 64
    provider = argv[0]
    path = credential_path(provider)
    try:
        with store_lock():
            try:
                path.lstat()
            except FileNotFoundError:
                print(f"aib-login-refresh: no {provider} login yet", file=sys.stderr)
                return 0
            except OSError:
                return 78
            if not trusted_store_file(path):
                return 78
            original = path.read_bytes()
            data = read_object(path)
            expiry = access_expiry(provider, data or {})
            if expiry is None:
                return 78
            threshold = integer("AIB_LOGIN_REFRESH_BELOW_S", cadence() + login_max_turn_seconds()
                                + login_margin_seconds() + login_slack_seconds())
            if expiry - now() > threshold:
                return 0

            private = Path(tempfile.mkdtemp(prefix=f"aib-login-{provider}."))
            os.chmod(private, 0o700)
            try:
                shutil.copytree(path.parent, private, dirs_exist_ok=True)
                local = private / path.name
                forced = force_private_expiry(provider, local)
                env = os.environ.copy()
                if provider == "claude-code":
                    env["CLAUDE_CONFIG_DIR"] = str(private)
                    command = [setting("AIB_CLAUDE_BIN", CLAUDE_BIN), "-p", "ok"]
                else:
                    env["CODEX_HOME"] = str(private)
                    command = [setting("AIB_CODEX_BIN", CODEX_BIN), "features", "list"]
                if run_cli(command, env) != 0:
                    return 1
                updated = local.read_bytes()
                if provider == "codex" and updated == forced:
                    # Codex 0.155.x does not initialize authentication for `features list`.
                    # app-server initializes the auth manager and exits cleanly on our closed
                    # stdin without starting a model turn. Older/fake CLIs may already have
                    # refreshed above, so retain the cheap compatibility trigger first.
                    if run_cli([setting("AIB_CODEX_BIN", CODEX_BIN), "app-server"], env) != 0:
                        return 1
                    updated = local.read_bytes()
                if updated == forced:
                    print(f"aib-login-refresh: {provider} credential unchanged", file=sys.stderr)
                    return 0 if store_meets_broker_floor(provider, path) else 1
                if path.read_bytes() != original:
                    print(f"aib-login-refresh: newer {provider} login preserved", file=sys.stderr)
                    return 0
                fd, raw = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
                tmp = Path(raw)
                try:
                    with os.fdopen(fd, "wb") as stream:
                        stream.write(updated)
                    os.chmod(tmp, 0o640)
                    os.replace(tmp, path)
                finally:
                    try:
                        tmp.unlink()
                    except FileNotFoundError:
                        pass
                return 0 if store_meets_broker_floor(provider, path) else 1
            finally:
                shutil.rmtree(private, ignore_errors=True)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        print(f"aib-login-refresh: {provider} refresh failed ({type(error).__name__})", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
