#!/usr/bin/env python3
"""Route systemd unit failures to the appropriate durable outbox."""

from __future__ import annotations

import datetime as dt
import json
import os
import re
import stat
import sys
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if os.environ.get("AIB_TEST_SEAMS") != "1" or (ROOT / ".aib-installed").exists():
    os.environ.pop("AIBOBNET_REGISTRY", None)
    os.environ.pop("AIB_OUTBOX_ROOT", None)
sys.path.insert(0, str(ROOT / "lib"))
from aib_control import registry_path  # noqa: E402

AGENT_RE = re.compile(r"aib-agent@([a-z0-9]+(?:-[a-z0-9]+)+)\.service\Z", re.ASCII)
LOGIN_RE = re.compile(r"aib-login(?:-refresh)?@([a-z0-9]+(?:-[a-z0-9]+)*)\.service\Z", re.ASCII)


def append_alarm(path: Path, recipient: str, body: str) -> int:
    directory_fd = file_fd = -1
    try:
        if path.parent.is_symlink() or not path.parent.is_dir():
            raise OSError("unsafe outbox directory")
        stamp = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
        alarm_id = f"alarm-{uuid.uuid4().hex}"
        directory_fd = os.open(
            path.parent,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
        file_fd = os.open(
            path.name,
            os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory_fd,
        )
        info = os.fstat(file_fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_nlink != 1
            or stat.S_IMODE(info.st_mode) & 0o777 != 0o660
        ):
            raise OSError("unsafe outbox file")
        data = (
            f"{stamp} | id:{alarm_id} | from:aib-alarm | to:human:{recipient} | "
            f"state:PERSISTED | {body}\n"
        ).encode("utf-8")
        written = 0
        while written < len(data):
            count = os.write(file_fd, data[written:])
            if count <= 0:
                raise OSError("short outbox write")
            written += count
        os.fsync(file_fd)
        return 0
    except OSError as error:
        print(f"aib-unit-alarm: outbox unavailable: {error}", file=sys.stderr)
        return 78
    finally:
        for fd in (file_fd, directory_fd):
            if fd >= 0:
                os.close(fd)


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        return 64
    unit = argv[0]
    outbox = Path(os.environ.get("AIB_OUTBOX_ROOT", "/srv/aib/outbox"))
    agent_match = AGENT_RE.fullmatch(unit)
    login_match = LOGIN_RE.fullmatch(unit)
    if unit == "aib-login-watch.service":
        return append_alarm(outbox / "_server" / "outbox.md", "ops", f"alarm:login_failed unit:{unit}")
    if login_match:
        provider = login_match.group(1)
        return append_alarm(outbox / "_server" / "outbox.md", "ops", f"alarm:login_failed provider:{provider} unit:{unit}")
    if not agent_match:
        return 64
    uid = agent_match.group(1)
    team = None
    try:
        registry = json.loads(registry_path(ROOT).read_text(encoding="utf-8"))
        agent = registry.get("agents", {}).get(uid)
        if isinstance(agent, dict) and isinstance(agent.get("team_uid"), str):
            team = agent["team_uid"]
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError):
        pass
    recipient = team or "ops"
    directory = team or "_server"
    return append_alarm(outbox / directory / "outbox.md", recipient, f"alarm:unit_failed agent:{uid} unit:{unit}")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
